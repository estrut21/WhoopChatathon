# Copy to .env and fill in. Every value is optional — the analysis, the CNS score and
# the cached literature all work with none of them set.

# Enables the coach (`cnscoach ask`, POST /ask, the dashboard's Ask tab).
CNSCOACH_ANTHROPIC_API_KEY=
CNSCOACH_MODEL=claude-opus-5

# NCBI asks callers to identify themselves. Without a key you get ~3 requests/second,
# with one ~10. Neither is needed to read the cached corpus in data/evidence/.
CNSCOACH_NCBI_API_KEY=
CNSCOACH_NCBI_EMAIL=

# Statistics. Raising alpha or widening a ROPE makes findings easier to claim — change
# these deliberately, and say so if you report results afterwards.
CNSCOACH_ALPHA=0.05
CNSCOACH_BOOTSTRAP_DRAWS=1000
CNSCOACH_MIN_OBS_PER_ATHLETE=30

# Baseline and load windows, in days.
CNSCOACH_BASELINE_WINDOW_DAYS=28
CNSCOACH_ACUTE_WINDOW_DAYS=7
CNSCOACH_CHRONIC_WINDOW_DAYS=28

# Point at a different panel CSV.
# CNSCOACH_RAW_CSV=data/raw/whoop_fitness_dataset_100k.csv
